<Window x:Class="Sub2Bar.Windows.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindowStyle}"
        Title="Sub2Bar 设置" Width="600" Height="580" MinWidth="560" MinHeight="540"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
    <Window.Resources>
        <Style x:Key="SettingsSectionTitle" TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="8,0,0,8" />
        </Style>

        <Style x:Key="SettingsPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>

        <Style x:Key="SettingsLabel" TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="SettingsSegment" TargetType="RadioButton"
               BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="86" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{StaticResource SurfaceRaisedBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="#243B32" />
                                <Setter TargetName="Chrome" Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsActionButton" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SettingsPrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="108" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#42C98C" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#42C98C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#2E9F6D" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#2E9F6D" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSliderRepeatButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" VerticalAlignment="Center"
                                Background="{TemplateBinding Background}" CornerRadius="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSliderThumb" TargetType="Thumb">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse x:Name="ThumbChrome" Fill="{StaticResource TextBrush}"
                                 Stroke="{StaticResource AccentBrush}" StrokeThickness="2" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Fill"
                                        Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Fill"
                                        Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSlider" TargetType="Slider">
            <Setter Property="Height" Value="24" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Margin="0,0,0,0">
                            <Track x:Name="PART_Track" Height="16" VerticalAlignment="Center"
                                   IsDirectionReversed="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SettingsSliderRepeatButton}"
                                                  Background="{StaticResource AccentBrush}"
                                                  Command="{x:Static Slider.DecreaseLarge}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SettingsSliderThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SettingsSliderRepeatButton}"
                                                  Background="{StaticResource BorderBrush}"
                                                  Command="{x:Static Slider.IncreaseLarge}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="22,18,18,12">
                <TextBlock Text="连接" Style="{StaticResource SettingsSectionTitle}" />
                <Border Style="{StaticResource SettingsPanel}" Margin="0,0,0,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="52" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="52" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="服务器地址" Style="{StaticResource SettingsLabel}" />
                            <TextBox Grid.Column="1" VerticalAlignment="Center"
                                     Text="{Binding ServerAddress, UpdateSourceTrigger=LostFocus}" />
                        </Grid>

                        <Border Grid.Row="1" Margin="14,0"
                                Background="{StaticResource BorderBrush}" />

                        <Grid Grid.Row="2" Margin="14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#F0A23A" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLoggedIn}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Grid.Column="1" Text="{Binding LoginStatus}"
                                       Margin="8,0,12,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Foreground" Value="#F0A23A" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLoggedIn}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Grid.Column="2" Command="{Binding ReloginCommand}"
                                    Style="{StaticResource SettingsActionButton}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               Text="&#xE77B;" Margin="0,0,8,0"
                                               VerticalAlignment="Center" TextWrapping="NoWrap" />
                                    <TextBlock Text="重新登录" VerticalAlignment="Center"
                                               TextWrapping="NoWrap" />
                                </StackPanel>
                            </Button>
                        </Grid>

                    </Grid>
                </Border>

                <TextBlock Text="刷新" Style="{StaticResource SettingsSectionTitle}" />
                <Border Style="{StaticResource SettingsPanel}" Margin="0,0,0,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="52" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="52" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="刷新周期" Style="{StaticResource SettingsLabel}" />
                            <ComboBox Grid.Column="1" VerticalAlignment="Center"
                                      ItemsSource="{Binding RefreshIntervals}"
                                      SelectedItem="{Binding RefreshIntervalMinutes}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat={}{0} 分钟}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <Border Grid.Row="1" Margin="14,0"
                                Background="{StaticResource BorderBrush}" />

                        <Grid Grid.Row="2" Margin="14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="极简显示" Style="{StaticResource SettingsLabel}" />
                            <UniformGrid Grid.Column="1" Rows="1" Columns="3">
                                <RadioButton Content="剩余额度" GroupName="MinimalDisplayMode"
                                             Style="{StaticResource SettingsSegment}"
                                             IsChecked="{Binding DisplayMode, Converter={StaticResource EnumEquals}, ConverterParameter=RemainingAmount}" />
                                <RadioButton Content="剩余比例" GroupName="MinimalDisplayMode"
                                             Style="{StaticResource SettingsSegment}"
                                             IsChecked="{Binding DisplayMode, Converter={StaticResource EnumEquals}, ConverterParameter=RemainingPercentage}" />
                                <RadioButton Content="已用额度" GroupName="MinimalDisplayMode"
                                             Style="{StaticResource SettingsSegment}"
                                             IsChecked="{Binding DisplayMode, Converter={StaticResource EnumEquals}, ConverterParameter=UsedAmount}" />
                            </UniformGrid>
                        </Grid>
                    </Grid>
                </Border>

                <TextBlock Text="通用" Style="{StaticResource SettingsSectionTitle}" />
                <Border Style="{StaticResource SettingsPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="52" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="52" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="52" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="52" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="56" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="登录 Windows 时自动启动"
                                       Style="{StaticResource SettingsLabel}" />
                            <CheckBox Grid.Column="1" Style="{StaticResource SwitchCheckBox}"
                                      IsChecked="{Binding LaunchAtLogin}" />
                        </Grid>

                        <Border Grid.Row="1" Margin="14,0"
                                Background="{StaticResource BorderBrush}" />

                        <Grid Grid.Row="2" Margin="14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="极简模式" Style="{StaticResource SettingsLabel}" />
                            <CheckBox Grid.Column="1" Style="{StaticResource SwitchCheckBox}"
                                      IsChecked="{Binding MinimalMode}" />
                        </Grid>

                        <Border Grid.Row="3" Margin="14,0"
                                Background="{StaticResource BorderBrush}" />

                        <Grid Grid.Row="4" Margin="14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="始终置顶" Style="{StaticResource SettingsLabel}" />
                            <CheckBox Grid.Column="1" Style="{StaticResource SwitchCheckBox}"
                                      IsChecked="{Binding AlwaysOnTop}" />
                        </Grid>

                        <Border Grid.Row="5" Margin="14,0"
                                Background="{StaticResource BorderBrush}" />

                        <Grid Grid.Row="6" Margin="14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#F0A23A" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnectionHealthy}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Grid.Column="1" Text="{Binding ConnectionStatus}"
                                       Margin="8,0,12,0" VerticalAlignment="Center"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Foreground" Value="#F0A23A" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnectionHealthy}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Grid.Column="2" Command="{Binding RefreshNowCommand}"
                                    Style="{StaticResource SettingsActionButton}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               Text="&#xE72C;" Margin="0,0,8,0"
                                               VerticalAlignment="Center" TextWrapping="NoWrap" />
                                    <TextBlock Text="立即刷新" VerticalAlignment="Center"
                                               TextWrapping="NoWrap" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Grid.Row="7" Margin="14,0"
                                Background="{StaticResource BorderBrush}" />

                        <Grid Grid.Row="8" Margin="14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="200" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="钉住后透明度" Style="{StaticResource SettingsLabel}" />
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="46" />
                                </Grid.ColumnDefinitions>
                                <Slider Minimum="10" Maximum="100" TickFrequency="5"
                                        IsSnapToTickEnabled="True"
                                        Style="{StaticResource SettingsSlider}"
                                        Value="{Binding PinnedOpacityPercent, Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                           TextAlignment="Right" Foreground="{StaticResource MutedTextBrush}"
                                           Text="{Binding PinnedOpacityPercent, StringFormat={}{0}%}" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Background="{StaticResource SurfaceBrush}"
                Padding="22,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ValidationMessage}" Foreground="#E45D5D"
                           VerticalAlignment="Center" Margin="0,0,12,0"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" Content="关闭" Command="{Binding CloseCommand}"
                        Height="34" Width="88" Padding="12,0" />
            </Grid>
        </Border>
    </Grid>
</Window>
