<Window x:Class="Sub2Bar.Windows.Views.FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindowStyle}"
        Title="Sub2Bar" Width="400" Height="430" MaxHeight="430"
        SizeToContent="Manual" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="False" AllowsTransparency="True"
        WindowStartupLocation="Manual" Background="Transparent"
        MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="QuotaMetaText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <DataTemplate x:Key="QuotaWindowTemplate">
            <StackPanel Margin="0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Period}" Style="{StaticResource QuotaMetaText}" />
                    <TextBlock Grid.Column="1" Text="{Binding Used}" Margin="12,0,0,0"
                               FontSize="11" Foreground="{StaticResource TextBrush}" />
                    <TextBlock Grid.Column="3" Text="{Binding RemainingAndReset}"
                               Style="{StaticResource QuotaMetaText}" TextAlignment="Right" />
                </Grid>
                <Grid Margin="0,6,0,0"
                      Visibility="{Binding HasUsedPercentage, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar Height="5" Margin="0,0,10,0" Minimum="0" Maximum="100"
                                 Value="{Binding UsedPercentage, Mode=OneWay}"
                                 Foreground="{Binding UsedPercentage, Converter={StaticResource ProgressBrush}}"
                                 Background="#353A37" BorderThickness="0" />
                    <TextBlock Grid.Column="1" Text="{Binding UsedAndLimit}"
                               Style="{StaticResource QuotaMetaText}"
                               Visibility="{Binding HasLimit, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </StackPanel>
        </DataTemplate>
        <Style x:Key="AdminAccountItemBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="2,5,2,12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <DataTemplate x:Key="AdminAccountDetailsTemplate">
            <StackPanel>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="7" Height="7" Fill="{Binding StatusColor}"
                             VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding StatusLabel}" Margin="6,0,0,0"
                               Style="{StaticResource QuotaMetaText}"
                               Foreground="{Binding StatusColor}" />
                    <TextBlock Grid.Column="2" Text="{Binding StatusDetails}" Margin="4,0,0,0"
                               Style="{StaticResource QuotaMetaText}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </Grid>
                <ItemsControl ItemsSource="{Binding UsageProgress}" Margin="0,3,0,0"
                              Visibility="{Binding HasUsageProgress, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Period}"
                                               Style="{StaticResource QuotaMetaText}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Used}" Margin="12,0,0,0"
                                               Style="{StaticResource QuotaMetaText}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Remaining}"
                                               Style="{StaticResource QuotaMetaText}" />
                                </Grid>
                                <ProgressBar Height="5" Margin="0,5,0,0" Minimum="0" Maximum="100"
                                             Value="{Binding UsedPercentage, Mode=OneWay}"
                                             Foreground="{Binding UsedPercentage, Converter={StaticResource ProgressBrush}}"
                                             Background="#353A37" BorderThickness="0"
                                             Visibility="{Binding HasUsedPercentage, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding Statistics}" Margin="0,4,0,0"
                                           Style="{StaticResource QuotaMetaText}" TextWrapping="Wrap"
                                           Visibility="{Binding HasStatistics, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid Margin="0,7,0,0"
                      Visibility="{Binding HasUsage, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar Height="5" Margin="0,0,10,0" Minimum="0" Maximum="100"
                                 Value="{Binding UsedPercentage, Mode=OneWay}"
                                 Foreground="{Binding UsedPercentage, Converter={StaticResource ProgressBrush}}"
                                 Background="#353A37" BorderThickness="0" />
                    <TextBlock Grid.Column="1" Text="{Binding UsedAndLimit}"
                               Style="{StaticResource QuotaMetaText}"
                               Visibility="{Binding HasUsedAndLimit, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="QuotaContentTemplate">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="14,10,14,12">
                <StackPanel>
                    <StackPanel Visibility="{Binding HasBalance, Converter={StaticResource BoolToVisibility}}"
                                Margin="0,0,0,10">
                        <TextBlock Text="余额" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding Balance}" FontSize="20" FontWeight="SemiBold" />
                    </StackPanel>

                    <TextBlock Text="没有可用订阅" Foreground="{StaticResource MutedTextBrush}"
                               HorizontalAlignment="Center" Margin="0,22"
                               Visibility="{Binding Subscriptions.Count, Converter={StaticResource ZeroToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Subscriptions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,0,1" Padding="2,2,2,12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{Binding Expiry}"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Windows}"
                                                      ItemTemplate="{StaticResource QuotaWindowTemplate}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding AdminAccounts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource AdminAccountItemBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <ContentControl Content="{Binding}"
                                                        ContentTemplate="{StaticResource AdminAccountDetailsTemplate}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LastUpdated}" Margin="7,0,0,0"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
    </Window.Resources>
    <Border Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="6">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="5" Opacity="0.4" />
        </Border.Effect>
        <Grid>
        <Grid x:Name="FullPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="HeaderBar" Grid.Row="0" Background="Transparent" Padding="14,8,10,6"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Sub2Bar" FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <ToggleButton x:Name="PinButton" Grid.Column="2"
                                  Style="{StaticResource IconToggleButton}" Content="&#xE840;"
                                  ToolTip="钉住面板" AutomationProperties.Name="钉住面板"
                                  Checked="PinButton_Checked" Unchecked="PinButton_Unchecked"
                                  Margin="0,0,4,0" />
                    <ToggleButton x:Name="MinimalModeButton" Grid.Column="3"
                                  Style="{StaticResource IconToggleButton}" Content="&#xE73F;"
                                  ToolTip="极简模式" AutomationProperties.Name="极简模式"
                                  Checked="MinimalModeButton_Checked"
                                  Unchecked="MinimalModeButton_Unchecked" Margin="0,0,4,0" />
                    <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE72C;"
                            Command="{Binding RefreshCommand}" ToolTip="刷新额度" Margin="0,0,4,0" />
                    <Button Grid.Column="5" Style="{StaticResource IconButton}" Content="&#xE713;"
                            Command="{Binding OpenSettingsCommand}" ToolTip="设置" />
                </Grid>
            </Border>

            <TabControl Grid.Row="1" x:Name="MainTabs" MaxHeight="560"
                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}">
                <TabItem Header="我的额度">
                    <ContentControl Content="{Binding}"
                                    ContentTemplate="{StaticResource QuotaContentTemplate}" />
                </TabItem>

                <TabItem Header="账号管理" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="14,10,14,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="账号" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding AdminAccountSelectionSummary}"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </Grid>
                            <TextBlock Text="{Binding AdminError}" Margin="0,0,0,8">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#F0A23A" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AdminError}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AdminError}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="没有可用账号" Foreground="{StaticResource MutedTextBrush}"
                                       HorizontalAlignment="Center" Margin="0,22"
                                       Visibility="{Binding AdminAccountOptions.Count, Converter={StaticResource ZeroToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding AdminAccountOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource AdminAccountItemBorderStyle}">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <CheckBox Grid.Column="1" Style="{StaticResource SwitchCheckBox}"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              Command="{Binding DataContext.ToggleAdminAccountCommand,
                                                                  RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                              CommandParameter="{Binding}" />
                                                </Grid>
                                                <ContentControl Content="{Binding}"
                                                                ContentTemplate="{StaticResource AdminAccountDetailsTemplate}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="订阅管理" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="14,10,14,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="有效订阅" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding AdminSubscriptionSummary}"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </Grid>
                            <TextBlock Text="没有有效订阅" Foreground="{StaticResource MutedTextBrush}"
                                       HorizontalAlignment="Center" Margin="0,22"
                                       Visibility="{Binding AdminSubscriptions.Count, Converter={StaticResource ZeroToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding AdminSubscriptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="0,0,0,1" Padding="2,5,2,12" Margin="0,0,0,10">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Expiry}"
                                                               Foreground="{StaticResource MutedTextBrush}" />
                                                </Grid>
                                                <TextBlock Text="{Binding Owner}" Margin="0,3,0,4"
                                                           Style="{StaticResource QuotaMetaText}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <ItemsControl ItemsSource="{Binding Windows}"
                                                              ItemTemplate="{StaticResource QuotaWindowTemplate}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
            <ContentControl Grid.Row="1" Content="{Binding}"
                            ContentTemplate="{StaticResource QuotaContentTemplate}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
            <Border x:Name="ContentDragHandle" Grid.Row="1" Height="8"
                    VerticalAlignment="Top" Panel.ZIndex="2"
                    Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown" />

            <Border x:Name="FooterBar" Grid.Row="2" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource FooterButton}"
                            Command="{Binding ReloginCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       Text="&#xE77B;" VerticalAlignment="Center" TextWrapping="NoWrap" />
                            <TextBlock Text="重新登录" Margin="6,0,0,0"
                                       VerticalAlignment="Center" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Button>
                    <Border Grid.Column="1" Width="1" Height="18" VerticalAlignment="Center"
                            Background="{StaticResource BorderBrush}" />
                    <Button Grid.Column="2" Style="{StaticResource FooterButton}"
                            Command="{Binding OpenConsoleCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       Text="&#xE774;" VerticalAlignment="Center" TextWrapping="NoWrap" />
                            <TextBlock Text="控制台" Margin="6,0,0,0"
                                       VerticalAlignment="Center" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Button>
                    <Border Grid.Column="3" Width="1" Height="18" VerticalAlignment="Center"
                            Background="{StaticResource BorderBrush}" />
                    <Button Grid.Column="4" Style="{StaticResource FooterButton}"
                            Command="{Binding ExitCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       Text="&#xE7E8;" VerticalAlignment="Center" TextWrapping="NoWrap" />
                            <TextBlock Text="退出" Margin="6,0,0,0"
                                       VerticalAlignment="Center" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
        <ContentControl x:Name="PinnedCompactPanel" Visibility="Collapsed"
                        Content="{Binding}" ContentTemplate="{StaticResource QuotaContentTemplate}" />
        <Border x:Name="MinimalPanel" Visibility="Collapsed" Background="Transparent"
                Padding="5,3"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Width="16" Height="16" Source="/Assets/Sub2Bar.ico"
                       Stretch="Uniform" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Margin="10,0,0,0"
                           Text="{Binding MinimalDisplayValue}"
                           FontSize="13" FontWeight="SemiBold"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Grid>
        </Border>
        </Grid>
    </Border>
</Window>
