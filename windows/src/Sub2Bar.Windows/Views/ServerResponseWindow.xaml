<Window x:Class="Sub2Bar.Windows.Views.ServerResponseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindowStyle}"
        Title="服务器响应" Width="760" Height="560" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="PathText" FontWeight="SemiBold" Margin="0,0,0,10" />
        <TextBox x:Name="ResponseText" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                 FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="复制" Width="84" Margin="0,0,8,0" Click="CopyButton_Click" />
            <Button Content="关闭" Width="84" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
